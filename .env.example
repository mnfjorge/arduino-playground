# Vercel Blob storage
# Generated automatically when a Blob store is linked to this project on Vercel,
# or created manually at https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Set to "true" to make lib/file-storage.ts read/write the local ./temp folder
# instead of Vercel Blob. Useful for local development without a Blob store.
USE_LOCAL_FILE_STORAGE=

# Base URL used to build the absolute /view/{id} link returned by the
# render_diagram MCP tool. Vercel sets VERCEL_URL automatically in
# deployments; set this for local development (e.g. http://localhost:3000)
# or to override with a custom domain.
APP_URL=
